# TANZEN — Tenant Application
# Copier ce fichier en .env.local et ajuster si besoin.

# Latence artificielle des services mock (ms) — sert uniquement à rendre les
# états Loading vérifiables à l'œil (skeletons, spinners), pas à simuler un
# vrai réseau. Mettre à 0 pour les tests (voir .env.test).
VITE_MOCK_API_DELAY=300

# BACKEND PENDING — aucune variable d'environnement liée à un backend réel
# (authentification, API tenant) n'existe encore. Elles seront ajoutées ici
# lorsque le backend existera.
